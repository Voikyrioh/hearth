{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Interface principale : les commandes de l'application, et l'écoute des événements de la liaison (link://*). Aucun accès direct aux greffons ni à la fenêtre depuis le web.",
  "windows": ["main"],
  "permissions": [
    "allow-get-settings",
    "allow-set-launch-at-startup",
    "allow-get-app-version",
    "allow-open-logs-folder",
    "allow-log-frontend-error",
    "allow-list-servers",
    "allow-list-link-states",
    "allow-probe-server",
    "allow-add-and-login",
    "allow-login",
    "allow-logout",
    "allow-retry-now",
    "allow-accept-fingerprint",
    "allow-update-server",
    "allow-remove-server",
    "allow-forget-credentials",
    "allow-list-fingerprint-alerts",
    "allow-list-link-notices",
    "allow-ack-link-notices",
    "allow-list-unread-operations",
    "allow-ack-unread-operations",
    "allow-get-notify-on-link-change",
    "allow-set-notify-on-link-change",
    "allow-get-notify-on-security-alert",
    "allow-set-notify-on-security-alert",
    "allow-set-displayed-server",
    "allow-get-dashboard",
    "allow-read-audit",
    "allow-export-audit",
    "allow-get-update-state",
    "allow-check-for-updates",
    "allow-postpone-update",
    "allow-install-update",
    "allow-check-account-input",
    "allow-list-accounts",
    "allow-create-account",
    "allow-change-account-role",
    "allow-set-account-password",
    "allow-change-own-password",
    "allow-close-account-sessions",
    "allow-delete-account",
    "allow-list-trusted-devices",
    "allow-remove-trusted-device",
    "allow-get-security",
    "allow-list-security-states",
    "allow-set-attack-mode",
    "allow-get-agent-update",
    "allow-update-agent",
    "allow-ack-agent-result",
    "allow-get-reauth-state",
    "allow-reauth-covers",
    "allow-set-reauth-setting",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
