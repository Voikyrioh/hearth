{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hearth",
  "identifier": "fr.voikyrioh.hearth",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Hearth",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "backgroundColor": "#1c1518"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Voikyrioh",
    "copyright": "Copyright (C) Voikyrioh. AGPL-3.0-or-later.",
    "shortDescription": "Surveille et pilote ton serveur depuis ton PC Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh",
        "customLanguageFiles": {
          "French": "installer/French.nsh"
        }
      }
    }
  }
}
